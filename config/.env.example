# Environment template
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=bentley_budget_bot

###############################################
# Mansa Star Bot Constellation – Discord Webhooks
###############################################

WEBHOOK_TITAN=
WEBHOOK_VEGA=
WEBHOOK_RIGEL=
WEBHOOK_DOGON=
WEBHOOK_ORION=
WEBHOOK_DRACO=
WEBHOOK_ALTAIR=
WEBHOOK_PROCRYON=
WEBHOOK_HYDRA=
WEBHOOK_TRITON=
WEBHOOK_DIONE=
WEBHOOK_CEPHEI=
WEBHOOK_RHEA=
WEBHOOK_JUPICITA=
WEBHOOK_CYGNUS=

# Optional: Control Center (Scheduler + Status Logs)
WEBHOOK_CONTROL_CENTER=

###############################################
# FastAPI Server Configuration
###############################################

API_HOST=0.0.0.0
API_PORT=8000

# Reserved general API secret; TradingView notifications use the dedicated secret below.
API_SECRET_KEY=

###############################################
# MT5 Expert Advisor (EA) Configuration
###############################################

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# EA WebRequest allowed URL (FastAPI endpoint)
EA_WEBREQUEST_URL=http://YOUR_SERVER_IP:8000/notify/signal

###############################################
# TradingView Webhook Integration
###############################################

# Put this value in the TradingView alert JSON "secret" field.
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_ALERT_ENDPOINT=http://YOUR_SERVER_IP:8000/tv-alert

###############################################
# Database / Logging
###############################################

MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

LOG_DIR=logs/
PAPERTRADE_LOG_DIR=papertrades/

###############################################
# Scheduler (Cosmic Signal Engine)
###############################################

SCHEDULER_MODE=production
SCHEDULER_TIMEZONE=US/Eastern

###############################################
# Bentley Bot / Cosmic Engine
###############################################

COSMIC_ENGINE_MODE=papertrade
COSMIC_SCORE_THRESHOLD=50

###############################################
# Mansa Capital Branding / SDK
###############################################

MANSA_SDK_KEY=
MANSA_SIGNALS_KEY=
